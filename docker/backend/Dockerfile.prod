# Прод-образ бэкенда (шаг 8.4): один образ на API (uvicorn), воркер и расписание Celery, Telegram-бота и команды
# администратора. Сборка — в отдельном слое с компилятором, в итоговый образ — только готовые пакеты.
FROM python:3.12-slim AS build
RUN apt-get update && apt-get install -y --no-install-recommends gcc libpq-dev && rm -rf /var/lib/apt/lists/*
RUN python -m venv /venv
ENV PATH=/venv/bin:$PATH PIP_NO_CACHE_DIR=1 PIP_DISABLE_PIP_VERSION_CHECK=1
COPY requirements.txt .
RUN pip install -r requirements.txt

FROM python:3.12-slim
ENV PATH=/venv/bin:$PATH PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
COPY --from=build /venv /venv
RUN useradd --create-home --uid 1000 appuser
WORKDIR /app
COPY . .
# Версия (коммит) — в /health и в Sentry; задаёт scripts/deploy.sh
ARG APP_VERSION=dev
ENV APP_VERSION=$APP_VERSION
USER appuser
EXPOSE 8000
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "2", "--no-server-header"]
