# Настройки сервера (шаг 8.4). scripts/setup.sh копирует этот файл в .env.prod и сам заполняет домен, почту и
# секреты (SECRET_KEY, ENCRYPTION_KEY, POSTGRES_PASSWORD). Остальное — по желанию: nano .env.prod, затем
# ./scripts/compose.sh up -d (подхватить изменения). .env.prod в репозиторий не попадает (.gitignore).
#
# ВАЖНО: сохраните копию .env.prod в менеджере паролей. Без ENCRYPTION_KEY резервная копия БД восстановится, но
# сохранённые ключи Ozon и токены банков расшифровать будет нельзя — их придётся ввести заново.

# ── Адрес сайта ──
# Домен без https:// — на него выпускается сертификат Let's Encrypt (A-запись домена → IP сервера)
DOMAIN=analytics.example.ru
# Почта для Let's Encrypt: предупреждения о сроке сертификата (обычно не приходят — продление автоматическое)
LETSENCRYPT_EMAIL=you@example.ru
# Адрес сайта — для ссылок в Telegram и приглашениях; ALLOWED_ORIGINS — тот же адрес
SITE_URL=https://analytics.example.ru
ALLOWED_ORIGINS=https://analytics.example.ru

# ── Кто может зарегистрироваться ──
# invite — только по приглашению: ./scripts/admin.sh invite → ссылка, человек сам задаёт пароль;
# closed — никто, аккаунты создаёт администратор: ./scripts/admin.sh create-user email;
# open — любой (откроем после шага 8.3a: подтверждение почты и сброс пароля письмом).
REGISTRATION_MODE=invite
# сколько дней действует приглашение
INVITE_DAYS=7

# ── Секреты (генерирует scripts/setup.sh; менять вручную не нужно) ──
# Подпись токенов входа: openssl rand -hex 32. Сменить — все выйдут из аккаунтов
SECRET_KEY=
# Шифрует ключи Ozon и токены банков. НЕ МЕНЯТЬ после первого запуска — иначе их не расшифровать
ENCRYPTION_KEY=
# База данных: пароль — только буквы и цифры (он стоит в адресе подключения)
POSTGRES_USER=ozon
POSTGRES_PASSWORD=
POSTGRES_DB=ozon_analytics

# ── Telegram-бот (docs/TELEGRAM.md) ──
# Создать бота у @BotFather → /newbot; токен — сюда, имя бота без @. Пусто — уведомления только на сайте
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

# ── Резервные копии в Object Storage (S3) — README-DEPLOY.md, «Резервные копии» ──
# Пусто — копии только на этом сервере (4 последние); при поломке сервера они пропадут вместе с ним.
# Адрес и регион — в панели хранилища: Timeweb Cloud — https://s3.timeweb.cloud и ru-1,
# Yandex Object Storage — https://storage.yandexcloud.net и ru-central1, Selectel — https://s3.ru-1.storage.selcloud.ru и ru-1
BACKUP_S3_ENDPOINT=
BACKUP_S3_REGION=
BACKUP_S3_BUCKET=
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=
# папка внутри бакета
BACKUP_S3_PREFIX=ozon-analytics
# адрес, который открывается после каждой удачной копии (например, Healthchecks.io) — узнать, если копии перестали
# делаться; пусто — не нужно
BACKUP_HEARTBEAT_URL=

# ── Ошибки в Sentry (sentry.io или совместимый GlitchTip) ──
# DSN проекта: Settings → Client Keys (DSN). Пусто — ошибки только в журналах контейнеров.
# Наружу не уходят пароли, ключи, тела запросов, IP и email пользователей
SENTRY_DSN=

# ── Обычно не меняются ──
ENVIRONMENT=production
DEBUG=false
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=30
# лимит неудачных попыток входа: с одного IP на один email / на любые email за окно (минут)
LOGIN_MAX_ATTEMPTS=5
LOGIN_MAX_ATTEMPTS_PER_IP=20
LOGIN_WINDOW_MINUTES=15
OZON_API_URL=https://api-seller.ozon.ru
TBANK_API_URL=https://business.tbank.ru/openapi
TOCHKA_API_URL=https://enter.tochka.com/uapi
TELEGRAM_API_URL=
