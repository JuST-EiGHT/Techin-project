POSTGRES_USER=ozon
POSTGRES_PASSWORD=change_me
POSTGRES_DB=ozon_analytics
DATABASE_URL=postgresql+asyncpg://ozon:change_me@db:5432/ozon_analytics
REDIS_URL=redis://redis:6379/0
# openssl rand -hex 32
SECRET_KEY=change_me
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=30
# Обязателен: без валидного ключа API не стартует. Шифрует API-ключи Ozon и токены банков —
# после сохранения ключей НЕ менять, иначе их не расшифровать. Сгенерировать:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=change_me
# Ozon Seller API (в тестах подменяется моком)
OZON_API_URL=https://api-seller.ozon.ru
# Банки по API (шаг 3.12); песочница Точки — https://enter.tochka.com/sandbox/v2
TBANK_API_URL=https://business.tbank.ru/openapi
TOCHKA_API_URL=https://enter.tochka.com/uapi
# список через запятую
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
NEXT_PUBLIC_API_URL=http://localhost:8000
# адрес бэкенда для сервера Next (route handlers /api/session/*); в Docker — http://api:8000
API_URL=http://api:8000
ENVIRONMENT=development
DEBUG=false
